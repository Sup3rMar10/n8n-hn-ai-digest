{
  "name": "Daily Hacker News AI Digest",
  "nodes": [
    {
      "parameters": {
        "content": "## Daily Hacker News AI digest\nEvery morning: fetch the HN front page, have Claude summarize it, post it to Discord.\n\n**Setup**\n1. Create an *HTTP Header Auth* credential named `Anthropic API key` (header `x-api-key`, value = your key) and select it on the Claude node.\n2. Paste your Discord webhook URL into the last node.",
        "height": 220,
        "width": 560
      },
      "id": "a0000000-0000-4000-8000-000000000001",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -260
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "a0000000-0000-4000-8000-000000000002",
      "name": "Every morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://hn.algolia.com/api/v1/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "tags",
              "value": "front_page"
            },
            {
              "name": "hitsPerPage",
              "value": "15"
            }
          ]
        }
      },
      "id": "a0000000-0000-4000-8000-000000000003",
      "name": "Fetch HN front page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const hits = $input.first().json.hits;\nconst list = hits\n  .map((h, i) => `${i + 1}. ${h.title} (${h.points} points) ${h.url ?? ''}`)\n  .join('\\n');\n\nreturn [{\n  json: {\n    prompt:\n      \"Summarize today's top Hacker News stories into a short digest for a busy engineer. \" +\n      'Group related stories, write one line each, and keep the total under 1500 characters.\\n\\n' +\n      list,\n  },\n}];"
      },
      "id": "a0000000-0000-4000-8000-000000000004",
      "name": "Build prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-opus-5-5', max_tokens: 4000, thinking: { type: 'adaptive' }, output_config: { effort: 'low' }, messages: [{ role: 'user', content: $json.prompt }] }) }}"
      },
      "id": "a0000000-0000-4000-8000-000000000005",
      "name": "Summarize with Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Anthropic API key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// The reply can contain thinking blocks, so keep only the text blocks.\nconst text = $input.first().json.content\n  .filter((block) => block.type === 'text')\n  .map((block) => block.text)\n  .join('');\n\nreturn [{ json: { digest: `*Daily HN digest*\\n${text}` } }];"
      },
      "id": "a0000000-0000-4000-8000-000000000006",
      "name": "Extract digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://discord.com/api/webhooks/REPLACE_WITH_YOUR_WEBHOOK",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $json.digest.slice(0, 1900) }) }}"
      },
      "id": "a0000000-0000-4000-8000-000000000007",
      "name": "Post to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ]
    }
  ],
  "connections": {
    "Every morning": {
      "main": [
        [
          {
            "node": "Fetch HN front page",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch HN front page": {
      "main": [
        [
          {
            "node": "Build prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build prompt": {
      "main": [
        [
          {
            "node": "Summarize with Claude",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Summarize with Claude": {
      "main": [
        [
          {
            "node": "Extract digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract digest": {
      "main": [
        [
          {
            "node": "Post to Discord",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
